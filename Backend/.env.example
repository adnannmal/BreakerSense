# Railway gives you this automatically when you link a PostgreSQL service
DATABASE_URL=postgresql://postgres:PHjNdSIRjBqGdZepnfLGOoPXjjkByomY@postgres.railway.internal:5432/railway

# Any long random string — used to sign login tokens
JWT_SECRET=change-this-to-something-random

# Railway sets this automatically, this is just a local fallback
PORT=4000

# Comma-separated frontend origins allowed to call the API from a browser (set in production).
CORS_ORIGIN=http://localhost:5173

# Optional tuning (defaults shown)
# ONLINE_AFTER_SECONDS=30
# STALE_AFTER_SECONDS=30
# COMMAND_TTL_SECONDS=30
# COMMAND_ACK_GRACE_SECONDS=10
# READINGS_RETENTION_DAYS=7
# MAX_CLOCK_SKEW_SECONDS=300
# JSON_BODY_LIMIT=32kb
# JWT_EXPIRES_IN=7d
# TRUST_PROXY_HOPS=1
# RATE_LIMIT_AUTH_MAX=20        (per IP per 15 min)
# RATE_LIMIT_DEVICE_MAX=120     (per controller+IP per minute)
# RATE_LIMIT_COMMAND_MAX=20     (per user per minute)
# RATE_LIMIT_KEY_MAX=10         (device create/rotate/revoke per user per 15 min)
# ML_MAX_SESSION_MINUTES=360
